# Copy to .env and fill in. The .env file is git-ignored.
# Credentials are loaded into the process environment via python-dotenv.

# --- LLM provider (NVIDIA API, OpenAI-compatible REST; no vendor SDK) ---------
# API key for NVIDIA-hosted models (Nemotron, etc.). Get one at build.nvidia.com.
NVIDIA_API_KEY=

# --- Application settings (prefixed WORKFLOW_COMPILER_) -----------------------
# Active provider name registered in the ProviderFactory: nemotron | openai | mock
WORKFLOW_COMPILER_LLM_PROVIDER=nemotron
# Model id to request from the provider.
WORKFLOW_COMPILER_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# Optional: override the provider base URL.
# WORKFLOW_COMPILER_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
WORKFLOW_COMPILER_LOG_LEVEL=INFO
# Directory where compiled workflow states are persisted as JSON.
WORKFLOW_COMPILER_STATE_STORE_PATH=.workflow_state

# Sequential review pipeline (default on): completeness -> grounding -> consistency
# passes over the LLM stages. Toggle per-run with --review / --no-review.
WORKFLOW_COMPILER_REVIEW_ENABLED=true
# WORKFLOW_COMPILER_REVIEW_STAGES=["discovery","facts"]

# Spec pipeline: auto-approve a workflow's graph at or above this health score;
# below it the workflow is left pending for manual review (approve / reject).
WORKFLOW_COMPILER_GRAPH_HEALTH_THRESHOLD=0.9

# Generate step-gated Temporal bundles (each top-level step waits for an `advance` signal).
# WORKFLOW_COMPILER_STEPWISE=false
