flowchart TD
    start(["Start"])
    end_node(["End"])
    activity_1["Pick items"]
    activity_2["Pack shipment"]
    activity_3["Dispatch shipment"]
    activity_4["Wait for carrier pickup confirmation"]
    activity_5["Capture payment"]
    decision_1{"Dispatch accepted?"}
    exception_1(["CarrierRejected"])
    exception_2(["PickupTimeout"])
    compensation_1["Unpack shipment"]
    event_1(["order.fulfil request"])
    event_2(["shipment_id"])
    event_3(["payment_id"])
    start --> activity_1
    activity_1 --> activity_2
    activity_2 --> activity_3
    activity_3 --> decision_1
    decision_1 -->|yes| activity_4
    decision_1 -->|no| exception_1
    activity_4 --> activity_5
    activity_5 --> end_node
    activity_3 -.->|on error| exception_1
    activity_4 -.->|on error| exception_2
    activity_2 -.->|compensate| compensation_1
    compensation_1 --> end_node
    start -.->|event| event_1
    event_1 -.->|triggers| activity_1
    activity_3 -.->|emits| event_2
    activity_5 -.->|emits| event_3
    exception_1 -->|terminates| end_node
    exception_2 -->|terminates| end_node
    classDef capture fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef validate fill:#fff8e1,stroke:#f9a825,color:#e65100;
    classDef process fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef activate fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c;
    class start,event_1,event_2 capture;
    class decision_1,exception_1,exception_2 validate;
    class activity_1,activity_2,activity_3,activity_4,compensation_1 process;
    class end_node,activity_5,event_3 activate;