flowchart TD
    start(["Start"])
    end_node(["End"])
    activity_1["Validate Cart"]
    activity_2["Reserve Inventory"]
    activity_3["Authorise Payment"]
    activity_4["Create Order"]
    decision_1{"Is Cart Eligible?"}
    decision_2{"Is Payment Authorised?"}
    exception_1(["CartNotEligible"])
    exception_2(["PaymentDeclined"])
    compensation_1["Release Inventory Reservation"]
    event_1(["checkout.submitted"])
    event_2(["order_id"])
    event_3(["authorization_id"])
    start --> activity_1
    activity_1 --> decision_1
    decision_1 -->|yes| activity_2
    decision_1 -->|no| exception_1
    activity_2 --> activity_3
    activity_3 --> decision_2
    decision_2 -->|yes| activity_4
    decision_2 -->|no| exception_2
    activity_4 --> end_node
    activity_3 -.->|on error| exception_2
    activity_2 -.->|compensate| compensation_1
    compensation_1 --> end_node
    start -.->|event| event_1
    event_1 -.->|triggers| activity_1
    activity_4 -.->|emits| event_2
    activity_3 -.->|emits| event_3
    exception_1 -->|terminates| end_node
    exception_2 -->|terminates| end_node
    classDef capture fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef validate fill:#fff8e1,stroke:#f9a825,color:#e65100;
    classDef process fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef activate fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c;
    class start,event_1 capture;
    class activity_1,activity_3,decision_1,decision_2 validate;
    class activity_2,activity_4 process;
    class end_node,exception_1,exception_2,compensation_1,event_2,event_3 activate;