flowchart TD
    start(["Start"])
    end_node(["End"])
    activity_1["Validate Order"]
    activity_2["Reserve Inventory"]
    activity_3["Charge Payment"]
    activity_4["Notify Customer"]
    activity_5["Record Settlement Event"]
    activity_6["Wait for Shipping Confirmation"]
    activity_7["Finalise Settlement"]
    decision_1{"Is Order Settleable?"}
    decision_2{"Is Payment Successful?"}
    exception_1(["ORDER_NOT_SETTLEABLE"])
    exception_2(["PaymentDeclined"])
    exception_3(["ShippingTimeout"])
    compensation_1["Release Inventory"]
    compensation_2["Refund Payment"]
    event_1(["order.settle"])
    event_2(["shipping.confirmed"])
    event_3(["settlement_id"])
    event_4(["payment_id"])
    start --> activity_1
    activity_1 --> decision_1
    decision_1 -->|yes| activity_2
    decision_1 -->|no| exception_1
    activity_2 --> activity_3
    activity_3 --> decision_2
    decision_2 -->|yes| activity_4
    decision_2 -->|no| exception_2
    activity_4 --> activity_5
    activity_5 --> activity_6
    activity_6 --> activity_7
    activity_7 --> end_node
    activity_1 -.->|on error| exception_1
    activity_3 -.->|on error| exception_2
    activity_6 -.->|on error| exception_3
    activity_2 -.->|compensate| compensation_1
    compensation_1 --> end_node
    exception_2 -.->|compensate| compensation_2
    compensation_2 --> end_node
    start -.->|event| event_1
    event_1 -.->|triggers| activity_1
    activity_6 -.->|emits| event_2
    activity_7 -.->|emits| event_3
    activity_3 -.->|emits| event_4
    exception_1 -->|terminates| end_node
    exception_3 -->|terminates| end_node
    classDef capture fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef validate fill:#fff8e1,stroke:#f9a825,color:#e65100;
    classDef process fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef activate fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c;
    class start,event_1 capture;
    class activity_1,decision_1,decision_2,exception_1,exception_2 validate;
    class activity_2,activity_3,activity_5,activity_6,activity_7,exception_3,event_4 process;
    class end_node,activity_4,compensation_1,compensation_2,event_2,event_3 activate;