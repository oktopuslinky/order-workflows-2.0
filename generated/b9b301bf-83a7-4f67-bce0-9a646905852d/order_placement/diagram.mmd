flowchart TD
    start(["Start"])
    end_node(["End"])
    activity_1["Validate cart"]
    activity_2["Reserve inventory"]
    activity_3["Authorise payment"]
    activity_4["Create order record"]
    activity_5["Release inventory"]
    activity_6["Send order confirmation email"]
    decision_1{"Is the cart eligible?"}
    decision_2{"Is payment authorised?"}
    exception_1(["CartNotEligible"])
    compensation_1["Release inventory"]
    event_1(["checkout.submitted"])
    event_2(["order_id"])
    event_3(["authorization_id"])
    event_4(["placement_status"])
    trigger_1["Trigger order-fulfilment"]
    start --> activity_1
    activity_1 --> decision_1
    decision_1 -->|yes| activity_2
    decision_1 -->|no| exception_1
    activity_2 --> activity_3
    activity_3 --> decision_2
    decision_2 -->|yes| activity_4
    decision_2 -->|no| activity_5
    activity_4 --> activity_5
    activity_5 --> activity_6
    activity_6 --> end_node
    activity_1 -.->|on error| exception_1
    activity_2 -.->|compensate| compensation_1
    compensation_1 --> end_node
    start -.->|event| event_1
    event_1 -.->|triggers| activity_1
    activity_4 -.->|emits| event_2
    activity_3 -.->|emits| event_3
    start -.->|event| event_4
    event_4 -.->|triggers| activity_1
    activity_6 -->|triggers| trigger_1
    exception_1 -->|terminates| end_node
    classDef capture fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef validate fill:#fff8e1,stroke:#f9a825,color:#e65100;
    classDef process fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef activate fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c;
    class start,event_1,event_4 capture;
    class activity_1,activity_3,decision_1,decision_2,exception_1 validate;
    class activity_2,activity_4,activity_5,compensation_1 process;
    class end_node,activity_6,event_2,event_3,trigger_1 activate;