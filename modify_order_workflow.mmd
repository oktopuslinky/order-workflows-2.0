    class activity_2,activity_4,activity_6,exception_3,exception_4,state_4,state_5,state_6,state_7 process;
    class end_node,activity_5,compensation_1,compensation_2,compensation_3,event_2,event_3,event_4,event_6,event_7,state_8,state_10 activate;