flowchart TD
    start(["Start"])
    end_node(["End"])
    activity_1["Receive Change Request"]
    activity_2["Load Existing Order and Service State"]
    activity_3["Revalidate (Service Qualification)"]
    activity_4["Apply Reconfiguration"]
    activity_5["Notify User (via Notification Service)"]
    activity_6["Update Billing/Rating"]
    decision_1{"Validate Change Request Payload"}
    decision_2{"Check Order Mutability"}
    decision_3{"Evaluate Impact Assessment Result"}
    decision_4{"Determine Reconfiguration Outcome"}
    exception_1(["Order locked (concurrent processing)"])
    exception_2(["Impact failure (change not feasible)"])
    exception_3(["Partial update (one leg failed)"])
    exception_4(["Billing mismatch (price recalculation failed)"])
    exception_5(["Inventory conflict (resource not available)"])
    compensation_1["Reverse Reconfiguration (if applied)"]
    compensation_2["Restore Original Order State"]
    compensation_3["Compensate Partial Update"]
    event_1(["Change requested (oms.order.change.requested)"])
    event_2(["Change validated (oms.order.change.validated)"])
    event_3(["Change rejected (oms.order.change.rejected)"])
    event_4(["Change planned (oms.order.change.planned)"])
    event_5(["Reconfigure requested (oms.service.reconfigure.requested)"])
    event_6(["Reconfigure completed (oms.service.reconfigure.completed)"])
    event_7(["Change completed (oms.order.change.completed)"])
    state_1["Received"]
    state_2["Validated (upon successful validation)"]
    state_3["Validated"]
    state_4["Planned (after impact assessment)"]
    state_5["Planned"]
    state_6["Reconfiguring (upon reconfigure request)"]
    state_7["Reconfiguring"]
    state_8["Completed (upon successful reconfiguration)"]
    state_9["Any State"]
    state_10["Rejected (upon failure or invalid request)"]
    start --> activity_1
    activity_1 --> decision_1
    decision_1 -->|yes| activity_2
    decision_1 -->|no| exception_1
    activity_2 --> decision_2
    decision_2 -->|yes| activity_3
    decision_2 -->|no| exception_2
    activity_3 --> decision_3
    decision_3 -->|yes| activity_4
    decision_3 -->|no| exception_3
    activity_4 --> decision_4
    decision_4 -->|yes| activity_5
    decision_4 -->|no| exception_4
    activity_5 --> activity_6
    activity_6 --> end_node
    activity_1 -.->|on error| exception_1
    exception_1 -.->|compensate| compensation_1
    compensation_1 --> end_node
    activity_2 -.->|on error| exception_2
    exception_2 -.->|compensate| compensation_2
    compensation_2 --> end_node
    activity_3 -.->|on error| exception_3
    exception_3 -.->|compensate| compensation_3
    compensation_3 --> end_node
    activity_4 -.->|on error| exception_4
    exception_4 -.->|compensate| compensation_1
    activity_5 -.->|on error| exception_5
    exception_5 -.->|compensate| compensation_1
    exception_1 -.->|retry| activity_1
    exception_2 -.->|retry| activity_2
    exception_3 -.->|retry| activity_3
    start -.->|event| event_1
    event_1 -.->|triggers| activity_1
    activity_6 -.->|emits| event_2
    activity_6 -.->|emits| event_3
    activity_6 -.->|emits| event_4
    start -.->|event| event_5
    event_5 -.->|triggers| activity_1
    activity_6 -.->|emits| event_6
    activity_6 -.->|emits| event_7
    state_1 -->|transition| state_2
    state_3 -->|transition| state_4
    state_5 -->|transition| state_6
    state_7 -->|transition| state_8
    state_9 -->|transition| state_10
