"""Worker process for the {{ workflow_class }} workflow.

Start a local Temporal dev server in one terminal::

    temporal server start-dev

Then, from inside this package directory, run the worker::

    python worker.py

Keep it running, then start a workflow with ``python starter.py``.
"""

from __future__ import annotations

import asyncio

from temporalio import workflow
from temporalio.client import Client
from temporalio.worker import Worker

with workflow.unsafe.imports_passed_through():
    from workflow import {{ workflow_class }}{% for c in child_class_names %}, {{ c }}{% endfor %}

{% if activity_fn_names %}
    from activities import (
{% for fn in activity_fn_names %}
        {{ fn }},
{% endfor %}
    )
{% endif %}
{% if trigger_fn_names %}
    from triggers import (
{% for fn in trigger_fn_names %}
        {{ fn }},
{% endfor %}
    )
{% endif %}

TASK_QUEUE = "{{ task_queue }}"


async def main() -> None:
    """Connect to Temporal and run the worker until cancelled."""
    client = await Client.connect("localhost:7233")
    worker = Worker(
        client,
        task_queue=TASK_QUEUE,
        workflows=[{{ workflow_class }}{% for c in child_class_names %}, {{ c }}{% endfor %}],
        activities=[{% for fn in activity_fn_names %}{{ fn }}{% if not loop.last %}, {% endif %}{% endfor %}{% for fn in trigger_fn_names %}{% if activity_fn_names or not loop.first %}, {% endif %}{{ fn }}{% endfor %}],
    )
    print(f"Worker started on task queue {TASK_QUEUE!r}. Press Ctrl+C to exit.")
    await worker.run()


if __name__ == "__main__":
    asyncio.run(main())
